# Public site
NEXT_PUBLIC_SITE_URL=https://heyystudiobeta.netlify.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MOCK_IMAGES=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=true
NEXT_PUBLIC_AUTH_MICROSOFT_ENABLED=true
HEYY_PUBLIC_MODE=beta
NEXT_PUBLIC_HEYY_PUBLIC_BETA=true

# Supabase server-only
SUPABASE_SERVICE_ROLE_KEY=

# Default OpenAI image model
# Used by Brand, Marketing, tools and workflows without a dedicated override.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TEXT_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_PREVIEW_IMAGE_QUALITY=medium
OPENAI_FINAL_IMAGE_QUALITY=high

# Architecture image generation
ARCHITECTURE_IMAGE_PROVIDER=openai
ARCHITECTURE_IMAGE_MODEL=gpt-image-2.5-sunburst
ARCHITECTURE_GEMINI_IMAGE_MODEL=gemini-3-pro-image
ARCHITECTURE_GROK_IMAGE_MODEL=grok-imagine-image-2.0
ARCHITECTURE_GROK_IMAGE_QUALITY=medium
ARCHITECTURE_TEXT_MODEL=gpt-4.1-mini

# Architecture image generation
ARCHITECTURE_IMAGE_PROVIDER=openai
ARCHITECTURE_IMAGE_MODEL=gpt-image-2.5-sunburst

# Alternative providers kept available for testing/fallback
ARCHITECTURE_GEMINI_IMAGE_MODEL=gemini-3-pro-image
ARCHITECTURE_GROK_IMAGE_MODEL=grok-imagine-image-2.0
ARCHITECTURE_GROK_IMAGE_QUALITY=medium

# Architecture text
ARCHITECTURE_TEXT_MODEL=gpt-4.1-mini

# Architecture Plan Foundation reasoning
ARCHITECTURE_PLAN_MODEL=gpt-5.6-terra
ARCHITECTURE_PLAN_REASONING_EFFORT=medium
ARCHITECTURE_PLAN_MAX_OUTPUT_TOKENS=20000

# Only run a second AI reasoning pass when major geometry problems are detected
ARCHITECTURE_PLAN_CORRECTION_ENABLED=true
ARCHITECTURE_PLAN_CORRECTION_MODEL=gpt-5.6-luna
ARCHITECTURE_PLAN_CORRECTION_REASONING_EFFORT=medium
ARCHITECTURE_PLAN_CORRECTION_MAX_ISSUES=8

# Interior image generation
INTERIOR_IMAGE_PROVIDER=openai
INTERIOR_IMAGE_MODEL=gpt-image-2.5-sunburst
INTERIOR_GEMINI_IMAGE_MODEL=gemini-3-pro-image
INTERIOR_GROK_IMAGE_MODEL=grok-imagine-image-2.0
INTERIOR_GROK_IMAGE_QUALITY=medium

# Optional per-workflow text overrides.
# Leave these blank/omitted unless you intentionally want a different model.
# OPENAI_MODEL=
# STUDIO_TEXT_MODEL=
PRESENTATION_TEXT_MODEL=gpt-5.6-luna
# HEYY_ASSISTANT_MODEL=

# Google Gemini image / Brand application fallback
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_SIZE=2K

BRAND_APPLICATION_IMAGE_PROVIDER=openai

# Google Gemini video
GEMINI_VIDEO_MODEL_FAST=veo-3.1-fast-generate-preview
GEMINI_VIDEO_MODEL_QUALITY=veo-3.1-generate-preview

# xAI / Grok
XAI_API_KEY=

# Topaz Developer API
TOPAZ_API_KEY=
TOPAZ_IMAGE_ENDPOINT=https://api.topazlabs.com/image/v1/enhance/async
TOPAZ_STATUS_ENDPOINT_TEMPLATE=https://api.topazlabs.com/image/v1/status/{id}
TOPAZ_MODEL_STANDARD=Standard V2
TOPAZ_MODEL_HIGH_FIDELITY=High Fidelity V2
TOPAZ_MODEL_LOW_RES=Low Resolution V2
TOPAZ_MODEL_ART=CGI
TOPAZ_MODEL_TEXT=Text Refine
TOPAZ_MODEL_STRONG=Recover 3

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Starter and Pro use separate Stripe products. Each product must have one
# active USD monthly price and one active USD yearly price.
STRIPE_STARTER_PRICE_ID_USD=
STRIPE_STARTER_ANNUAL_PRICE_ID_USD=
STRIPE_PRO_PRICE_ID_USD=
STRIPE_PRO_ANNUAL_PRICE_ID_USD=
STRIPE_PORTAL_CONFIGURATION_ID=

# Phase 7 commercial values are centralized in lib/platform/plans.ts.
# Do not mirror plan prices, allowances or pack values in environment variables.

# Transactional email
RESEND_API_KEY=
ADMIN_EMAIL=hello@heyystudio.com

# Admin Basic Auth — replace before deployment
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Architecture testing / live AI routing
AI_MODE=live
ARCHITECTURE_TEST_PLAN=pro

# Welcome trial (new credit denomination: 1 old credit = 10 new credits)
HEYY_WELCOME_CREDITS=30

# Heyy Studio invoice identity — fill with confirmed production legal details.
HEYY_INVOICE_BUSINESS_NAME=Heyy Studio
HEYY_INVOICE_ABN=
HEYY_INVOICE_ADDRESS=
HEYY_INVOICE_EMAIL=hello@heyystudio.com
HEYY_INVOICE_WEBSITE=https://heyystudiobeta.netlify.app
HEYY_INVOICE_GST_REGISTERED=false

# Stripe Tax: add the business head-office address and Australian GST registration
# in Stripe Tax first, then enable automatic tax. Configure the Starter/Pro
# Stripe products with the correct tax code. The optional code below is used
# for dynamic credit-pack and expert-production line items; when blank, Stripe
# Tax uses the default product tax code configured in Tax Settings.
HEYY_STRIPE_AUTOMATIC_TAX=false
HEYY_STRIPE_TAX_CODE=
